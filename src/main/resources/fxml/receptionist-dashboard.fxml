<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.hotelNova.views.ReceptionistDashboardController">
    
    <top>
        <VBox style="-fx-padding: 15; -fx-background-color: #2c3e50;">
            <children>
                <HBox spacing="20" alignment="CENTER_LEFT">
                    <children>
                        <Text text="Panel Recepcionista - Hotel Nova" 
                              style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: white;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="logoutButton" text="Cerrar Sesión" 
                               style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                    </children>
                </HBox>
                <MenuBar style="-fx-background-color: #34495e;">
                    <menus>
                        <Menu text="Reservas">
                            <items>
                                <MenuItem fx:id="checkInMenuItem" text="Check-in"/>
                                <MenuItem fx:id="checkOutMenuItem" text="Check-out"/>
                                <MenuItem fx:id="viewReservationsMenuItem" text="Ver Reservas"/>
                            </items>
                        </Menu>
                        <Menu text="Habitaciones">
                            <items>
                                <MenuItem fx:id="viewRoomsMenuItem" text="Ver Disponibilidad"/>
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>
            </children>
        </VBox>
    </top>
    
    <center>
        <VBox spacing="20" alignment="CENTER" style="-fx-padding: 40;">
            <children>
                <Text text="Panel de Recepción" 
                      style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-fill: #2c3e50;"/>
                
                <HBox spacing="30" alignment="CENTER">
                    <children>
                        <VBox spacing="15" alignment="CENTER" style="-fx-padding: 25; -fx-background-color: #ecf0f1; -fx-background-radius: 10;">
                            <children>
                                <Button fx:id="quickCheckInButton" text="Check-in Rápido" 
                                       prefWidth="180" prefHeight="60"
                                       style="-fx-font-size: 16px; -fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
                                <Text text="Registrar nueva reserva" style="-fx-font-size: 12px; -fx-fill: #7f8c8d;"/>
                            </children>
                        </VBox>
                        
                        <VBox spacing="15" alignment="CENTER" style="-fx-padding: 25; -fx-background-color: #ecf0f1; -fx-background-radius: 10;">
                            <children>
                                <Button fx:id="quickCheckOutButton" text="Check-out Rápido" 
                                       prefWidth="180" prefHeight="60"
                                       style="-fx-font-size: 16px; -fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold;"/>
                                <Text text="Procesar salida de huésped" style="-fx-font-size: 12px; -fx-fill: #7f8c8d;"/>
                            </children>
                        </VBox>
                        
                        <VBox spacing="15" alignment="CENTER" style="-fx-padding: 25; -fx-background-color: #ecf0f1; -fx-background-radius: 10;">
                            <children>
                                <Button fx:id="roomStatusButton" text="Estado Habitaciones" 
                                       prefWidth="180" prefHeight="60"
                                       style="-fx-font-size: 16px; -fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;"/>
                                <Text text="Ver disponibilidad" style="-fx-font-size: 12px; -fx-fill: #7f8c8d;"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>
                
                <GridPane hgap="20" vgap="20" alignment="CENTER">
                    <children>
                        <VBox spacing="10" alignment="CENTER" style="-fx-padding: 20; -fx-background-color: #ecf0f1; -fx-background-radius: 10;"
                              GridPane.rowIndex="0" GridPane.columnIndex="0">
                            <children>
                                <Text text="Check-ins Hoy" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                                <Text fx:id="todayCheckInsLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-fill: #27ae60;"/>
                                <Text text="Nuevas llegadas" style="-fx-font-size: 14px;"/>
                            </children>
                        </VBox>
                        
                        <VBox spacing="10" alignment="CENTER" style="-fx-padding: 20; -fx-background-color: #ecf0f1; -fx-background-radius: 10;"
                              GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <children>
                                <Text text="Check-outs Hoy" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                                <Text fx:id="todayCheckOutsLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-fill: #e67e22;"/>
                                <Text text="Salidas programadas" style="-fx-font-size: 14px;"/>
                            </children>
                        </VBox>
                        
                        <VBox spacing="10" alignment="CENTER" style="-fx-padding: 20; -fx-background-color: #ecf0f1; -fx-background-radius: 10;"
                              GridPane.rowIndex="1" GridPane.columnIndex="0">
                            <children>
                                <Text text="Habitaciones Disponibles" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                                <Text fx:id="availableRoomsLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-fill: #3498db;"/>
                                <Text text="Para asignar" style="-fx-font-size: 14px;"/>
                            </children>
                        </VBox>
                        
                        <VBox spacing="10" alignment="CENTER" style="-fx-padding: 20; -fx-background-color: #ecf0f1; -fx-background-radius: 10;"
                              GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <children>
                                <Text text="Ocupación Actual" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                                <Text fx:id="currentOccupancyLabel" text="0%" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-fill: #8e44ad;"/>
                                <Text text="Hotel lleno" style="-fx-font-size: 14px;"/>
                            </children>
                        </VBox>
                    </children>
                </GridPane>
                
                <Text fx:id="statusLabel" style="-fx-font-size: 14px; -fx-fill: #7f8c8d;"/>
            </children>
        </VBox>
    </center>
</BorderPane>
