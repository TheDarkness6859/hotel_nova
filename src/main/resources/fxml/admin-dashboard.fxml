<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.hotelNova.views.AdminDashboardController">
    
    <top>
        <VBox style="-fx-padding: 15; -fx-background-color: #2c3e50;">
            <children>
                <HBox spacing="20" alignment="CENTER_LEFT">
                    <children>
                        <Text text="Panel Administrador - Hotel Nova" 
                              style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: white;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="logoutButton" text="Cerrar Sesión" 
                               style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                    </children>
                </HBox>
                <MenuBar style="-fx-background-color: #34495e;">
                    <menus>
                        <Menu text="Habitaciones">
                            <items>
                                <MenuItem fx:id="manageRoomsMenuItem" text="Gestionar Habitaciones"/>
                            </items>
                        </Menu>
                        <Menu text="Reservas">
                            <items>
                                <MenuItem fx:id="manageReservationsMenuItem" text="Gestionar Reservas"/>
                            </items>
                        </Menu>
                        <Menu text="Usuarios">
                            <items>
                                <MenuItem fx:id="manageUsersMenuItem" text="Gestionar Usuarios"/>
                            </items>
                        </Menu>
                        <Menu text="Reportes">
                            <items>
                                <MenuItem fx:id="occupancyReportMenuItem" text="Reporte de Ocupación"/>
                                <MenuItem fx:id="revenueReportMenuItem" text="Reporte de Ingresos"/>
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>
            </children>
        </VBox>
    </top>
    
    <center>
        <VBox spacing="20" alignment="CENTER" style="-fx-padding: 40;">
            <children>
                <Text text="Bienvenido al Panel de Administración" 
                      style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-fill: #2c3e50;"/>
                
                <GridPane hgap="20" vgap="20" alignment="CENTER">
                    <children>
                        <VBox spacing="10" alignment="CENTER" style="-fx-padding: 20; -fx-background-color: #ecf0f1; -fx-background-radius: 10;"
                              GridPane.rowIndex="0" GridPane.columnIndex="0">
                            <children>
                                <Text text="Habitaciones" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                                <Text fx:id="totalRoomsLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-fill: #3498db;"/>
                                <Text text="Total" style="-fx-font-size: 14px;"/>
                            </children>
                        </VBox>
                        
                        <VBox spacing="10" alignment="CENTER" style="-fx-padding: 20; -fx-background-color: #ecf0f1; -fx-background-radius: 10;"
                              GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <children>
                                <Text text="Reservas Activas" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                                <Text fx:id="activeReservationsLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-fill: #27ae60;"/>
                                <Text text="Hoy" style="-fx-font-size: 14px;"/>
                            </children>
                        </VBox>
                        
                        <VBox spacing="10" alignment="CENTER" style="-fx-padding: 20; -fx-background-color: #ecf0f1; -fx-background-radius: 10;"
                              GridPane.rowIndex="1" GridPane.columnIndex="0">
                            <children>
                                <Text text="Ocupación" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                                <Text fx:id="occupancyLabel" text="0%" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-fill: #e67e22;"/>
                                <Text text="Actual" style="-fx-font-size: 14px;"/>
                            </children>
                        </VBox>
                        
                        <VBox spacing="10" alignment="CENTER" style="-fx-padding: 20; -fx-background-color: #ecf0f1; -fx-background-radius: 10;"
                              GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <children>
                                <Text text="Ingresos del Mes" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                                <Text fx:id="monthlyRevenueLabel" text="$0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-fill: #8e44ad;"/>
                                <Text text="Este mes" style="-fx-font-size: 14px;"/>
                            </children>
                        </VBox>
                    </children>
                </GridPane>
                
                <Text fx:id="statusLabel" style="-fx-font-size: 14px; -fx-fill: #7f8c8d;"/>
            </children>
        </VBox>
    </center>
</BorderPane>
